# Copy to .env.prod on the server (chmod 600) and fill in. NEVER commit the real file.
# Used by: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Core (required) ---
PUBLIC_ORIGIN=https://connector.example.com
ADMIN_TOKEN=ch_admin_CHANGE_ME_long_random_value
ENCRYPTION_KEY=CHANGE_ME_long_random_value   # losing this makes stored credentials unreadable: back it up separately

# --- Optional: extra origins allowed as post-OAuth return URLs (PUBLIC_ORIGIN is always allowed) ---
# ALLOWED_RETURN_ORIGINS=

# --- Accounts (email + password sign-in). Signups stay closed unless you set a mode. ---
ACCOUNTS_SIGNUP_MODE=disabled            # disabled | invite | open (open needs an email backend)
ACCOUNTS_INVITE_CODES=                   # comma-separated, for invite mode
ACCOUNTS_BLOCKED_EMAIL_DOMAINS=          # comma-separated domains refused at signup

# --- Email for accounts: pick ONE backend ---
ACCOUNTS_EMAIL_BACKEND=none              # none | ses | smtp
ACCOUNTS_EMAIL_FROM=ConnectorHub <support@example.com>   # must be a verified sender

# Amazon SES (API). Leave the keys empty to use the machine's IAM role. Key needs only ses:SendEmail.
ACCOUNTS_SES_REGION=us-east-1
ACCOUNTS_SES_ACCESS_KEY=
ACCOUNTS_SES_SECRET_KEY=

# SMTP (alternative)
ACCOUNTS_SMTP_HOST=
ACCOUNTS_SMTP_PORT=587
ACCOUNTS_SMTP_USER=
ACCOUNTS_SMTP_PASSWORD=
ACCOUNTS_SMTP_FROM=
