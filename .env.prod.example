# Copy to .env.prod on the server (chmod 600) and fill in. NEVER commit the real file.
# Used by: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Core (required) ---
PUBLIC_ORIGIN=https://connector.example.com
ADMIN_TOKEN=ch_admin_CHANGE_ME_long_random_value
ENCRYPTION_KEY=CHANGE_ME_long_random_value   # losing this makes stored credentials unreadable: back it up separately

# --- Optional: shared public sandbox. Off by default. When on, visitors without a token can use the console and API
# inside their own isolated tenant (separate from the operator). Do not enable on an instance holding real credentials.
# ALLOW_PUBLIC_ACCESS=false

# --- Optional: extra origins allowed as post-OAuth return URLs (PUBLIC_ORIGIN is always allowed) ---
# ALLOWED_RETURN_ORIGINS=
